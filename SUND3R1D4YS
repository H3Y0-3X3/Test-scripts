function refreshUI()
    for key,ref in pairs(uiRefs) do
        local sec,field = key:match("^(%w+)%.(.+)$")
        if sec and field and Config[sec] then
            local v = Config[sec][field]
            if ref.kind=="toggle" then ref.apply(v, true)
            elseif ref.kind=="slider" then ref.setValue(v) end
        end
    end
    for name,ref in pairs(modeRefs) do ref.setLabel(Config.FunctionMode[name]) end
    cfgStatus.Text = "Autoload: "..(getAutoload() or "none")
    applyVisualSettings()
end

cfgSaveBtn.MouseButton1Click:Connect(function()
    if saveConfig(cfgInput.Text) then
        cfgStatus.Text = "Saved: "..cfgInput.Text
        cfgStatus.TextColor3 = Color3.fromRGB(120,255,140)
    end
end)
cfgLoadBtn.MouseButton1Click:Connect(function()
    if loadConfig(cfgInput.Text) then
        refreshUI()
        cfgStatus.Text = "Loaded: "..cfgInput.Text
        cfgStatus.TextColor3 = Color3.fromRGB(120,255,140)
    end
end)
cfgAutoBtn.MouseButton1Click:Connect(function()
    setAutoload(cfgInput.Text)
    cfgStatus.Text = "Autoload set: "..cfgInput.Text
end)
cfgDelBtn.MouseButton1Click:Connect(function()
    if deleteConfig(cfgInput.Text) then
        cfgStatus.Text = "Deleted: "..cfgInput.Text
        if getAutoload()==cfgInput.Text then setAutoload(nil) end
    end
end)

