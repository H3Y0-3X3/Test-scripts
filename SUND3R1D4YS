local espCache = {}
local function isTeammate(plr)
    if not Config.ESP.TeamCheck then return false end
    if not LocalPlayer.Team or not plr.Team then return false end
    return LocalPlayer.Team == plr.Team
end
local function drawLine(frame, p1, p2)
    local v1,on1 = Camera:WorldToViewportPoint(p1)
    local v2,on2 = Camera:WorldToViewportPoint(p2)
    if not (on1 and on2) then frame.Visible = false return end
    local a,b = Vector2.new(v1.X,v1.Y), Vector2.new(v2.X,v2.Y)
    local diff = b-a
    frame.Visible = true
    frame.Size = UDim2.fromOffset(diff.Magnitude, 1)
    frame.Position = UDim2.fromOffset(a.X, a.Y)
    frame.Rotation = math.deg(math.atan2(diff.Y, diff.X))
end
local function clearESPForPlayer(plr)
    if espCache[plr] then
        for _,l in ipairs(espCache[plr].boxLines) do l:Destroy() end
        for _,l in ipairs(espCache[plr].skeletonLines) do l:Destroy() end
        if espCache[plr].chams then espCache[plr].chams:Destroy() end
        espCache[plr] = nil
    end
end
Players.PlayerRemoving:Connect(function(plr) clearESPForPlayer(plr) end)
Players.PlayerAdded:Connect(function(plr)
    plr.CharacterRemoving:Connect(function() clearESPForPlayer(plr) end)
end)

RunService.RenderStepped:Connect(function()
    if not Config.ESP.Enabled then
        for plr,_ in pairs(espCache) do clearESPForPlayer(plr) end
        return
    end
    local col = animatedGradient()
    local myChar = LocalPlayer.Character
    local myRoot = myChar and myChar:FindFirstChild("HumanoidRootPart")
    for _,plr in ipairs(Players:GetPlayers()) do
        if plr==LocalPlayer or isTeammate(plr) then clearESPForPlayer(plr) continue end
        local char = plr.Character
        local hrp = char and char:FindFirstChild("HumanoidRootPart")
        local head = char and char:FindFirstChild("Head")
        if not (char and hrp and head) then clearESPForPlayer(plr) continue end
        if myRoot and (myRoot.Position - hrp.Position).Magnitude > Config.ESP.MaxDist then clearESPForPlayer(plr) continue end
        if not espCache[plr] then
            local cache = {boxLines={}, skeletonLines={}, chams=nil}
            if Config.ESP.Box then
                for i=1,4 do
                    local f = Instance.new("Frame")
                    f.BackgroundColor3=col; f.BorderSizePixel=0; f.ZIndex=2; f.Parent=MainGui
                    table.insert(cache.boxLines,f)
                end
            end
            if Config.ESP.Skeleton then
                for i=1,6 do
                    local f = Instance.new("Frame")
                    f.BackgroundColor3=col; f.BorderSizePixel=0; f.ZIndex=2; f.Parent=MainGui
                    table.insert(cache.skeletonLines,f)
                end
            end
            if Config.ESP.Chams then
                local hl = Instance.new("Highlight")
                hl.Name = "SUND3R1D4YS_Chams"
                hl.FillColor=col; hl.FillTransparency=0.5
                hl.OutlineColor=col; hl.OutlineTransparency=0
                hl.DepthMode=Enum.HighlightDepthMode.AlwaysOnTop
                hl.Parent = char
                cache.chams = hl
            end
            espCache[plr] = cache
        end
        local cache = espCache[plr]
        if Config.ESP.Box and #cache.boxLines==4 then
            local rootV, on = Camera:WorldToViewportPoint(hrp.Position)
            if on then
                local topV = Camera:WorldToViewportPoint(hrp.Position + Vector3.new(0,3,0))
                local botV = Camera:WorldToViewportPoint(hrp.Position - Vector3.new(0,3,0))
                local height = math.abs(topV.Y - botV.Y)
                local width = height*0.55
                local x,y = rootV.X-width/2, rootV.Y-height/2
                cache.boxLines[1].Size=UDim2.fromOffset(width,1); cache.boxLines[1].Position=UDim2.fromOffset(x,y); cache.boxLines[1].BackgroundColor3=col; cache.boxLines[1].Visible=true
                cache.boxLines[2].Size=UDim2.fromOffset(width,1); cache.boxLines[2].Position=UDim2.fromOffset(x,y+height); cache.boxLines[2].BackgroundColor3=col; cache.boxLines[2].Visible=true
                cache.boxLines[3].Size=UDim2.fromOffset(1,height); cache.boxLines[3].Position=UDim2.fromOffset(x,y); cache.boxLines[3].BackgroundColor3=col; cache.boxLines[3].Visible=true
                cache.boxLines[4].Size=UDim2.fromOffset(1,height); cache.boxLines[4].Position=UDim2.fromOffset(x+width,y); cache.boxLines[4].BackgroundColor3=col; cache.boxLines[4].Visible=true
            else
                for _,l in ipairs(cache.boxLines) do l.Visible=false end
            end
        end
        if cache.chams then cache.chams.FillColor=col; cache.chams.OutlineColor=col end
        if Config.ESP.Skeleton and #cache.skeletonLines>=6 then
            local neck = head.Position - Vector3.new(0,0.5,0)
            local torso = char:FindFirstChild("UpperTorso") or char:FindFirstChild("Torso")
            local lower = char:FindFirstChild("LowerTorso")
            local lArm = char:FindFirstChild("LeftUpperArm") or char:FindFirstChild("Left Arm")
            local rArm = char:FindFirstChild("RightUpperArm") or char:FindFirstChild("Right Arm")
            local lLeg = char:FindFirstChild("LeftUpperLeg") or char:FindFirstChild("Left Leg")
            local rLeg = char:FindFirstChild("RightUpperLeg") or char:FindFirstChild("Right Leg")
            local torsoPos = torso and torso.Position or hrp.Position
            local hipPos = lower and lower.Position or (hrp.Position - Vector3.new(0,1.5,0))
            drawLine(cache.skeletonLines[1], neck, torsoPos)
            drawLine(cache.skeletonLines[2], torsoPos, hipPos)
            if lArm and rArm then
                drawLine(cache.skeletonLines[3], torsoPos, lArm.Position)
                drawLine(cache.skeletonLines[4], torsoPos, rArm.Position)
            end
            if lLeg and rLeg then
                drawLine(cache.skeletonLines[5], hipPos, lLeg.Position)
                drawLine(cache.skeletonLines[6], hipPos, rLeg.Position)
            end
            for _,l in ipairs(cache.skeletonLines) do l.BackgroundColor3=col end
        end
    end
end)

