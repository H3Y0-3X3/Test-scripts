end

local function setNoTexture(enabled)
    noTextureActive = enabled
    if textureConn then textureConn:Disconnect() textureConn = nil end
    if enabled then
        stripTexturesFrom(workspace)
        textureConn = workspace.DescendantAdded:Connect(function(desc)
            if not noTextureActive then return end
            if desc:IsA("Decal") or desc:IsA("Texture") or desc:IsA("SurfaceAppearance") then
                pcall(function() desc:Destroy() end)
            end
        end)
    end
end

local function applyVisualSettings()
    setRatio(Config.Visual.RatioEnabled, Config.Visual.RatioValue)
    applyAvatarMode()
    setNoTexture(Config.Visual.NoTexture)
end

