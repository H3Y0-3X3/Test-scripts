            elseif Config.FunctionMode[name]=="Toggle" then bindStates[name]=not bindStates[name] end
        end
    end
end)
UserInputService.InputEnded:Connect(function(i)
    for name,key in pairs(Config.Keybinds) do
        local match
        if typeof(key)=="EnumItem" and key.EnumType==Enum.KeyCode then match=(i.KeyCode==key)
        elseif typeof(key)=="EnumItem" and key.EnumType==Enum.UserInputType then match=(i.UserInputType==key) end
        if match and Config.FunctionMode[name]=="Hold" then bindHeld[name]=false end
    end
end)
local function bindActive(name)
    if Config.FunctionMode[name]=="Always" then return true end
    return bindStates[name] or bindHeld[name]
end

