-- ============================================================
--  2. GRADIENT
-- ============================================================
local function lerpColor(a,b,t) return Color3.new(a.R+(b.R-a.R)*t, a.G+(b.G-a.G)*t, a.B+(b.B-a.B)*t) end
local function animatedGradient()
    local t = (tick() * Config.Gradient.Speed) % 1
    return lerpColor(Config.Gradient.ColorA, Config.Gradient.ColorB, (math.sin(t*math.pi*2)+1)/2)
end
local function gradientText(text, speed)
    local now = tick() * speed
    local parts = {}
    for i = 1, #text do
        local ch = text:sub(i,i)
        local wave = (math.sin((now + i*0.15)*math.pi*2)+1)/2
        local c = lerpColor(Config.Gradient.ColorA, Config.Gradient.ColorB, wave)
        table.insert(parts, string.format('<font color="rgb(%d,%d,%d)">%s</font>',
            math.floor(c.R*255), math.floor(c.G*255), math.floor(c.B*255), ch))
    end
    return table.concat(parts)
end

