local oldIndex
oldIndex = hookmetamethod(game, "__index", function(t, k)
    if checkcaller() then return oldIndex(t,k) end
    if (Config.Silent.Enabled or bindActive("Silent")) and t:IsA("Mouse") and (k=="Hit" or k=="Target") then
        local target = getClosestTarget(Config.Silent.FOV, true, Config.Silent.WallCheck, Config.Silent.Hitbox)
        if target then
            if k=="Hit" then return CFrame.new(target.Position + target.Velocity*Config.Silent.Prediction)
            else return target end
        end
    end
    return oldIndex(t,k)
end)

local oldNamecall
oldNamecall = hookmetamethod(game, "__namecall", function(self, ...)
    local method = getnamecallmethod()
    if checkcaller() then return oldNamecall(self, ...) end
    if (Config.Silent.Enabled or bindActive("Silent")) then
        local args = {...}
        if (method=="FindPartOnRayWithIgnoreList" or method=="FindPartOnRay") and args[1] then
            local target = getClosestTarget(Config.Silent.FOV, true, Config.Silent.WallCheck, Config.Silent.Hitbox)
            if target then
                local origin = args[1].Origin
                args[1] = Ray.new(origin, (target.Position-origin).Unit*1000)
            end
            return oldNamecall(self, table.unpack(args))
        end
    end
    return oldNamecall(self, ...)
end)

