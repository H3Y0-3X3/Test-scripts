local ratioActive, ratioFactor = false, 1.0
local function setRatio(enabled, factor)
    ratioActive = enabled
    ratioFactor = factor or 1.0
end

RunService:BindToRenderStep("SUND3R1D4YS_Ratio", Enum.RenderPriority.Camera.Value + 1, function()
    if not ratioActive or ratioFactor == 1.0 then return end
    local cam = workspace.CurrentCamera
    if not cam then return end
    local cf = cam.CFrame
    local scaleMatrix = CFrame.new(0,0,0, 1,0,0, 0,1/ratioFactor,0, 0,0,1)
    cam.CFrame = cf * scaleMatrix
end)

