local function stripTexturesFrom(root)
    for _,v in ipairs(root:GetDescendants()) do
        if v:IsA("Decal") or v:IsA("Texture") or v:IsA("SurfaceAppearance") then
            pcall(function() v:Destroy() end)
        end
