local function serializeTable(tbl, indent)
    indent = indent or ""
    local lines = { "{" }
    for k,v in pairs(tbl) do
        local keyStr = type(k)=="string" and string.format("%q", k) or tostring(k)
        local valStr
        if type(v)=="table" then valStr = serializeTable(v, indent.."  ")
        elseif typeof(v)=="EnumItem" then valStr = string.format('ENUM("%s.%s")', v.EnumType.Name, v.Name)
        elseif type(v)=="Color3" then valStr = string.format("Color3.fromRGB(%d,%d,%d)", math.floor(v.R*255), math.floor(v.G*255), math.floor(v.B*255))
        elseif type(v)=="string" then valStr = string.format("%q", v)
        elseif type(v)=="boolean" or type(v)=="number" then valStr = tostring(v)
        else valStr = "nil" end
        table.insert(lines, indent.."  ["..keyStr.."] = "..valStr..",")
    end
    table.insert(lines, indent.."}")
    return table.concat(lines, "\n")
end
local function deserializeTable(str)
    local env = setmetatable({}, {__index=_G})
    env.ENUM = function(s)
        local en, it = s:match("^(%w+)%.(%w+)$")
        if en and it then local ok,v=pcall(function() return Enum[en][it] end); if ok then return v end end
        return nil
    end
    env.Color3 = Color3
    local fn = loadstring("return "..str)
    if not fn then return nil end
    setfenv(fn, env)
    local ok,res = pcall(fn)
    if ok then return res end
    return nil
end

local function getSnapshot()
    return {
        Aimbot={Enabled=Config.Aimbot.Enabled,FOV=Config.Aimbot.FOV,Smooth=Config.Aimbot.Smooth,Part=Config.Aimbot.Part,WallCheck=Config.Aimbot.WallCheck,TeamCheck=Config.Aimbot.TeamCheck,ShowFOV=Config.Aimbot.ShowFOV},
        Silent={Enabled=Config.Silent.Enabled,FOV=Config.Silent.FOV,Hitbox=Config.Silent.Hitbox,WallCheck=Config.Silent.WallCheck,Prediction=Config.Silent.Prediction},
        Trigger={Enabled=Config.Trigger.Enabled,Delay=Config.Trigger.Delay,TeamCheck=Config.Trigger.TeamCheck},
        ESP={Enabled=Config.ESP.Enabled,Box=Config.ESP.Box,Chams=Config.ESP.Chams,Skeleton=Config.ESP.Skeleton,TeamCheck=Config.ESP.TeamCheck,MaxDist=Config.ESP.MaxDist},
        Gradient={Speed=Config.Gradient.Speed,ColorA=Config.Gradient.ColorA,ColorB=Config.Gradient.ColorB},
        Crosshair={Enabled=Config.Crosshair.Enabled,Speed=Config.Crosshair.Speed,Size=Config.Crosshair.Size,Glow=Config.Crosshair.Glow,GlowThickness=Config.Crosshair.GlowThickness,Spin=Config.Crosshair.Spin,Follow=Config.Crosshair.Follow,Pulse=Config.Crosshair.Pulse,SigOffsetY=Config.Crosshair.SigOffsetY},
        Visual={RatioEnabled=Config.Visual.RatioEnabled,RatioValue=Config.Visual.RatioValue,FOVEnabled=Config.Visual.FOVEnabled,FOVValue=Config.Visual.FOVValue,AvatarMode=Config.Visual.AvatarMode,NoTexture=Config.Visual.NoTexture},
        Keybinds={Aimbot=Config.Keybinds.Aimbot,Silent=Config.Keybinds.Silent,Trigger=Config.Keybinds.Trigger},
        FunctionMode={Aimbot=Config.FunctionMode.Aimbot,Silent=Config.FunctionMode.Silent,Trigger=Config.FunctionMode.Trigger},
    }
end
local function applySnapshot(snap)
    if type(snap)~="table" then return false end
    for sec,vals in pairs(snap) do
        if Config[sec] and type(vals)=="table" then
            for k,v in pairs(vals) do if Config[sec][k]~=nil then Config[sec][k]=v end end
        end
    end
    return true
end
local function saveConfig(name)
    if not name or name=="" then return false end
    writefile(CFG_FOLDER..name..".txt", "return "..serializeTable(getSnapshot()))
    return true
end
local function loadConfig(name)
    if not name or name=="" then return false end
    local path = CFG_FOLDER..name..".txt"
    if not isfile(path) then return false end
    local snap = deserializeTable(readfile(path):gsub("^return%s*",""))
    if not snap then return false end
    return applySnapshot(snap)
end
local function deleteConfig(name)
    local path = CFG_FOLDER..name..".txt"
    if isfile(path) then delfile(path) return true end
    return false
end
local function setAutoload(name)
    if not name or name=="" then if isfile(AUTOLOAD_FILE) then delfile(AUTOLOAD_FILE) end return end
    writefile(AUTOLOAD_FILE, name)
end
local function getAutoload()
    if isfile(AUTOLOAD_FILE) then local n=readfile(AUTOLOAD_FILE); if n and n~="" then return n end end
    return nil
end

